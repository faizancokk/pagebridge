FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci
COPY apps/api apps/api
RUN npm run db:generate -w @pagebridge/api && npm run build -w @pagebridge/api
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api/dist ./dist
COPY --from=build /app/apps/api/prisma ./prisma
COPY --from=build /app/apps/api/package.json ./package.json
# Run pending Prisma migrations on every start, then launch the API.
CMD ["sh","-c","./node_modules/.bin/prisma migrate deploy --schema prisma/schema.prisma && node dist/index.js"]
